rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == "hanenashi@gmail.com"
        && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isOwner()
        || (request.auth != null
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true);
    }

    match /admins/{uid} {
      allow read: if isOwner() || (request.auth != null && request.auth.uid == uid);
      allow create, update: if isOwner() && request.resource.data.enabled is bool;
      allow delete: if isOwner();
    }

    match /clubs/{clubId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;

      match /rounds/{roundId} {
        allow read: if true;
        allow create, update: if isAdmin()
          && request.resource.data.clubId == clubId
          && request.resource.data.roundId == clubId + ":" + roundId;
        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
